{
  "llm": {
    "provider": "custom",
    "api_key": "not-needed",
    "model": "auto",
    "base_url": "http://localhost:8080/v1",
    "temperature": 0.7,
    "max_tokens": 2000,
    "timeout": 120
  },
  "providers": {
    "openai": {
      "api_key": null,
      "default_model": "gpt-4o",
      "base_url": "https://api.openai.com/v1"
    },
    "anthropic": {
      "api_key": null,
      "default_model": "claude-3-opus-20240229",
      "base_url": "https://api.anthropic.com/v1"
    },
    "google": {
      "api_key": null,
      "default_model": "gemini-1.5-pro",
      "base_url": "https://generativelanguage.googleapis.com/v1beta"
    },
    "cohere": {
      "api_key": null,
      "default_model": "command-r",
      "base_url": "https://api.cohere.ai/v1"
    },
    "groq": {
      "api_key": null,
      "default_model": "llama-3.1-70b-versatile",
      "base_url": "https://api.groq.com/openai/v1"
    },
    "together": {
      "api_key": null,
      "default_model": "meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo",
      "base_url": "https://api.together.xyz/v1"
    },
    "perplexity": {
      "api_key": null,
      "default_model": "llama-3.1-70b-instruct",
      "base_url": "https://api.perplexity.ai"
    },
    "mistral": {
      "api_key": null,
      "default_model": "mistral-large-latest",
      "base_url": "https://api.mistral.ai/v1"
    },
    "fireworks": {
      "api_key": null,
      "default_model": "accounts/fireworks/models/llama-v3p1-70b-instruct",
      "base_url": "https://api.fireworks.ai/inference/v1"
    },
    "openrouter": {
      "api_key": null,
      "default_model": "openai/gpt-4o",
      "base_url": "https://openrouter.ai/api/v1"
    },
    "ollama": {
      "api_key": null,
      "default_model": "llama3.1",
      "base_url": "http://localhost:11434"
    },
    "lmstudio": {
      "api_key": null,
      "default_model": "local-model",
      "base_url": "http://localhost:1234/v1"
    },
    "custom": {
      "api_key": "not-needed",
      "default_model": "auto",
      "base_url": "http://localhost:8080/v1"
    }
  },
  "local_models": {
    "enabled": true,
    "model_path": "",
    "framework": "llama.cpp",
    "device": "vulkan",
    "weight_modification": {
      "enabled": false,
      "backup_weights": true,
      "modification_dir": "modified_weights"
    }
  },
  "attacks": {
    "enable_all": true,
    "enable_prompt_injection": true,
    "enable_jailbreak": true,
    "enable_data_extraction": true,
    "enable_system_prompt_extraction": true,
    "enable_adversarial_inputs": true,
    "enable_role_confusion": true,
    "enable_context_injection": true,
    "enable_weight_manipulation": true
  },
  "adversarial": {
    "advanced_techniques": {
      "gradient_based": false,
      "token_manipulation": true,
      "semantic_perturbation": true,
      "multi_modal_attacks": false,
      "transfer_attacks": true
    },
    "attack_combinations": true,
    "adaptive_attacks": true,
    "ensemble_attacks": false
  },
  "judge": {
    "enabled": true,
    "mode": "both",
    "fallback_on_error": true,
    "temperature": 0.1,
    "max_tokens": 500
  },
  "evaluator": {
    "judge_enabled": true,
    "keyword_heuristics": true,
    "default_severity": "medium"
  },
  "comparison": {
    "enabled": false,
    "targets": [
      {
        "provider": "openai",
        "model": "gpt-4o",
        "api_key_env": "OPENAI_API_KEY",
        "label": "GPT-4o"
      },
      {
        "provider": "anthropic",
        "model": "claude-3-opus-20240229",
        "api_key_env": "ANTHROPIC_API_KEY",
        "label": "Claude 3 Opus"
      }
    ]
  },
  "reporting": {
    "output_dir": "reports",
    "format": "html",
    "include_responses": true,
    "severity_threshold": "medium",
    "detailed_analysis": true,
    "include_owasp_mapping": true,
    "include_judge_reasoning": true,
    "per_attack_severity": true,
    "specific_recommendations": true
  },
  "rate_limiting": {
    "enabled": true,
    "delay_between_requests": 0.5,
    "max_requests_per_minute": 60,
    "backoff_strategy": "exponential"
  },
  "logging": {
    "level": "INFO",
    "file": "llm_redteam.log",
    "console_output": true
  },
  "payload_loader": {
    "enabled": false,
    "encryption_key": null
  },
  "persistence": {
    "enabled": false
  },
  "c2_communication": {
    "enabled": false,
    "server_url": "http://localhost:8080/c2",
    "encryption": true,
    "encryption_key": null,
    "beacon_interval": 30,
    "jitter": 0.2
  },
  "data_exfiltration": {
    "enabled": false,
    "keylogger": false,
    "screenshot": false,
    "file_exfiltration": false
  },
  "polymorphic_encoding": {
    "enabled": false
  }
}

